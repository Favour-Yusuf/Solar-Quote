# Copy this file to .env.local and fill in real values from your Supabase
# project (Project Settings -> API, and Project Settings -> Database).

# --- Supabase Auth / client SDK -----------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
# Server-only — never expose to the browser. Used for privileged operations
# like the public /q/[shareToken] PDF route and Storage bucket setup.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Prisma / Postgres ---------------------------------------------------
# Pooled connection (port 6543, via Supavisor/pgbouncer) — used by the app
# at runtime. Add `?pgbouncer=true` as shown so Prisma disables features
# the pooler can't support in transaction mode.
DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432, no pooler) — used only by `prisma migrate`.
DIRECT_URL="postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres"

# --- App -------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
