generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Mirrors the Supabase `auth.users` row for an installer who signs in.
/// Prisma does not manage `auth.users` itself — this row is created by a
/// server action right after Supabase Auth confirms sign-up.
model User {
  id        String   @id @db.Uuid
  email     String   @unique
  fullName  String
  createdAt DateTime @default(now())

  company Company?

  @@map("users")
}

model Company {
  id      String @id @default(cuid())
  ownerId String @unique @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  name          String
  phone         String?
  email         String?
  website       String?
  address       String?
  logoUrl       String?
  brandColor    String?
  bankName      String?
  accountName   String?
  accountNumber String?

  /// ISO 4217-ish currency code (e.g. "NGN") pre-filled onto new quotes; the
  /// installer can still override it per quote. See lib/currency.ts.
  defaultCurrency     String @default("NGN")
  /// Number of days a new quote stays valid by default, pre-filled into the
  /// quote builder's validity selector.
  defaultValidityDays Int    @default(30)

  /// Next quote display number to assign (e.g. 1000 -> "Q-1000"), incremented
  /// transactionally by services/quotes.ts when a quote is created.
  quoteSequence Int       @default(1000)
  onboardedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customers Customer[]
  products  Product[]
  quotes    Quote[]
  packages  Package[]

  @@map("companies")
}

model Customer {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name         String
  /// The customer's own business name, if any (distinct from `company` above,
  /// which is the installer's account).
  businessName String?
  email        String?
  phone        String?
  address      String?

  createdAt DateTime @default(now())

  quotes Quote[]

  @@index([companyId])
  @@map("customers")
}

model Product {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name       String
  unit       String
  priceCents Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quoteItems   QuoteItem[]
  packageItems PackageItem[]

  @@index([companyId])
  @@map("products")
}

enum QuoteStatus {
  DRAFT
  SENT
  PAID
}

model Quote {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  /// The package this quote was generated from, if any — kept for future
  /// package-analytics reporting; never required and never re-validated.
  sourcePackageId String?
  sourcePackage   Package? @relation(fields: [sourcePackageId], references: [id], onDelete: SetNull)

  /// Display number, rendered as "Q-{number}"; unique per company.
  number         Int
  depositPercent Int         @default(50)
  /// Currency this quote is priced in, snapshotted from the company default at
  /// creation so later changing the company default never re-denominates it.
  currency       String      @default("NGN")
  notes          String?
  /// Absolute date this quotation stops being valid, shown as "Valid until …".
  /// Resolved at creation from the chosen validity period or a custom date.
  validUntil     DateTime?
  status         QuoteStatus @default(DRAFT)
  /// Public, unguessable id used by the no-auth /q/[shareToken] view and the
  /// WhatsApp share link.
  shareToken     String      @unique @default(cuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items QuoteItem[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([customerId])
  @@map("quotes")
}

model QuoteItem {
  id        String   @id @default(cuid())
  quoteId   String
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  /// Snapshot of the product at the time the quote was created, so editing
  /// or deleting a product later never changes a historical quote.
  name       String
  unit       String
  priceCents Int
  qty        Int

  @@index([quoteId])
  @@map("quote_items")
}

model Package {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name           String
  description    String?
  category       String?
  coverImageUrl  String?
  depositPercent Int       @default(50)
  isActive       Boolean   @default(true)
  isFavorite     Boolean   @default(false)
  /// Bumped whenever this package is applied to a quote — powers "recently
  /// used" ordering in the quote builder's package picker.
  lastUsedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items  PackageItem[]
  quotes Quote[]

  @@index([companyId])
  @@map("packages")
}

model PackageItem {
  id        String   @id @default(cuid())
  packageId String
  package   Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  /// Snapshot at add-time, mirroring QuoteItem — deleting or repricing a
  /// product later never corrupts a saved package.
  name             String
  unit             String
  priceCents       Int
  customPriceCents Int?
  qty              Int

  @@index([packageId])
  @@map("package_items")
}
